# Backend environment variables
# Copy this file to .env and fill in real values

# ─── Chain ───────────────────────────────────────────────────────────────────
RPC_URL=https://base-sepolia-rpc.publicnode.com
CHAIN_ID=84532

# ─── Contract addresses (Base Sepolia) ───────────────────────────────────────
VAULT_ADDRESS=
LENDING_POOL_ADDRESS=
NAV_ORACLE_ADDRESS=
DUSD_ADDRESS=
DUST_ADDRESS=
PUBLISHER_KEY=

# ─── KeeperHub ───────────────────────────────────────────────────────────────
# Get from: https://app.keeperhub.com → Settings → API Keys → Organisation tab
KEEPERHUB_API_KEY=kh_...

# ─── Agent runtime ───────────────────────────────────────────────────────────
# Ledger backend: "mock" | "keeperhub"
LEDGER=keeperhub

# Poll interval in milliseconds.
# 300000 = 5 min (safe for free tier quota).
# Set to 60000 only when recording demo video.
POLL_MS=300000

# Set to "off" to demonstrate the overlap-guard bug on camera.
# Never use "off" in normal operation.
OVERLAP_GUARD=on

# ─── HTTP server ─────────────────────────────────────────────────────────────
PORT=3001
