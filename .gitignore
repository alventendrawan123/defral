# deps
node_modules/
.pnp
.pnp.js

# build
dist/
build/
out/
.next/
.vite/
*.tsbuildinfo

# foundry
cache/
out/
# Foundry nests as <pkg>/broadcast/<Script>.s.sol/<chainId>/dry-run/. A pattern with an
# internal slash is anchored to this file's directory, so `broadcast/*/dry-run/` matched
# nothing at all - it was looking at the repo root, not SC/. Real broadcasts stay tracked:
# they are the deployment evidence the submission links to.
**/broadcast/**/dry-run/
# CATATAN: lib/ TIDAK diabaikan — forge install bikin git submodule, dan
# pointer submodule-nya harus ter-commit supaya clone bersih bisa build.

# env & secrets — JANGAN PERNAH commit kh_ API key atau private key
.env
.env.*
!.env.example
*.key
*.pem

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# test
coverage/
.nyc_output/

# CATATAN: docs/evidence/*.json HARUS ter-commit.
# Retensi log free-tier KeeperHub tidak terverifikasi, transaksi kita 11-12 Agt,
# penjurian 17-20 Agt. Halaman bukti membaca arsip statik, bukan API live.
!docs/evidence/
!docs/evidence/**
