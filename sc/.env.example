# Defral SC - Base Sepolia (chain 84532). Salin ke .env dan isi. JANGAN commit .env.

# Tiga key HARUS tiga alamat berbeda. Kalau publisher dan deployer sama, argumen
# "agent tidak bisa menggerakkan harga yang dia baca" runtuh - dan itu tesis Defral,
# bukan detail kerapian.
PRIVATE_KEY=0x...            # deployer: owner pool, buka posisi demo
PUBLISHER_KEY=0x...          # publisher NAV. Agent tidak boleh punya ini
BORROWER_KEY=0x...           # borrower demo: deploy vault, setujui cadangan

# Etherscan V2 multichain key (etherscan.io/myapikey). Cuma perlu untuk --verify.
ETHERSCAN_API_KEY=...

# KeeperHub ORGANISATION key. Settings > API Keys > tab Organisation.
# BUKAN key wfb_ (itu user key, cuma untuk webhook trigger). Ditampilkan sekali.
KEEPERHUB_API_KEY=kh_...

# ALAMAT saja, bukan private key.
#
# Sumber yang benar:  GET /api/user/wallet  ->  walletAddress
#   curl -s -H "Authorization: Bearer $KEEPERHUB_API_KEY" \
#        https://app.keeperhub.com/api/user/wallet
#
# JANGAN pakai `kh wallet info --json` / `keeperhub-wallet info`. Perintah itu membaca
# subOrg berdiri sendiri yang tidak tersambung ke organisasi ini, dan alamatnya tidak
# pernah mengeksekusi apa pun. Nilai ini di-bake sebagai immutable agentExecutor di
# setiap vault - salah isi berarti vault mati permanen. Lihat docs/KEEPERHUB-SETUP.md.
AGENT_EXECUTOR=0x...
